# ============================================================================
#  Automatizador de Instagram — SEUS INPUTS (um lugar só)
#  Copie para .env e preencha. Rode `node src/cli.js doctor` para conferir.
#  Deixe em branco o que ainda não tiver — o bot roda em modo dry-run/heurístico.
# ============================================================================

# ---- Inteligência (Fase 1 e 3): agrupar, sugerir, analisar ----------------
# Chave da Anthropic. Sem ela, o agrupamento usa heurística e o relatório é básico.
ANTHROPIC_API_KEY=

# ---- Transcrição de fala (Fase 1) -----------------------------------------
# Chave da OpenAI (Whisper). Sem ela, a transcrição vira um placeholder.
OPENAI_API_KEY=

# ---- Serviço HTTP (n8n) ----------------------------------------------------
# Token que o n8n envia no header x-studio-token. Defina um segredo forte no VPS.
STUDIO_TOKEN=
# Token separado, usado na URL /media que o Metricool baixa. Se vazio, usa STUDIO_TOKEN.
STUDIO_MEDIA_TOKEN=
# Porta do serviço (padrão 4599).
STUDIO_PORT=
# Raiz do estúdio (padrão ./studio-data/Instagram-Studio). Aponte para a pasta
# sincronizada do Drive quando estiver no VPS.
STUDIO_ROOT=

# ---- Postagem (Metricool) --------------------------------------------------
# userToken do Metricool: Configurações → API (requer plano com API).
METRICOOL_USER_TOKEN=
# IDs da sua marca no Metricool (ou liste com GET /api/v2/settings/brands).
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
