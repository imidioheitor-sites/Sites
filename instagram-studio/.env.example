# Copie para .env e preencha para o modo LIVE (produção). O demo NÃO precisa de nada disto.

# --- Claude (agrupamento + visão) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Transcrição de voz (Whisper via OpenAI, provider default) ---
OPENAI_API_KEY=

# --- Google Drive (service account com acesso à pasta do estúdio) ---
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
DRIVE_INBOX_FOLDER_ID=
DRIVE_AGRUPADOS_FOLDER_ID=
DRIVE_ROOT_FOLDER_ID=
