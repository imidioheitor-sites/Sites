# Copie para .env e preencha para o modo LIVE (produção). O demo NÃO precisa de nada disto.

# --- Claude (agrupamento + visão) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Transcrição de voz (Whisper via OpenAI, provider default) ---
OPENAI_API_KEY=

# --- Google Drive (service account com acesso à pasta do estúdio) ---
# Compartilhe a pasta Instagram-Studio com o email da service account!
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
DRIVE_INBOX_FOLDER_ID=
DRIVE_AGRUPADOS_FOLDER_ID=
DRIVE_ROOT_FOLDER_ID=
# Opcional: força o motor de agrupamento (padrão: usa Claude se houver a chave)
# INGEST_USE_CLAUDE=true

# --- Postagem (Fase 2 — MVP via Metricool) ---
METRICOOL_TOKEN=
METRICOOL_BLOG_ID=

# --- Relatórios / Insights (Fase 3) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
REPORT_FROM=me
REPORT_TO=
